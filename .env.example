# --- telegram ---
BOT_TOKEN=

# --- openai / llm ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# опционально: свой endpoint (например, локальная llm через ollama-совместимый api)
OPENAI_BASE_URL=

# --- fatsecret (oauth2 client credentials) ---
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# --- ocr: pytesseract | easyocr ---
OCR_ENGINE=pytesseract

# --- база данных ---
DB_PATH=data/bot.db
DATA_DIR=data

# --- планировщик ---
DEFAULT_TZ=Europe/Moscow

# --- логирование ---
LOG_LEVEL=INFO
